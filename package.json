    "@nx/devkit": "^22.6.4",
    "@nx/plugin": "^22.6.4",
    "@onecx/accelerator": "^7.16.1",
    "@onecx/angular-accelerator": "^7.16.1",
    "@onecx/angular-auth": "^7.16.1",
    "@onecx/angular-integration-interface": "^7.16.1",
