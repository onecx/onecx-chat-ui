    "@onecx/angular-webcomponents": "^6.27.0",
    "@onecx/integration-interface": "^6.27.0",
    "@onecx/ngrx-accelerator": "^6.27.0",
    "@onecx/nx-plugin": "^6.0.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "keycloak-js": "^25.0.6",
    "marked": "^18.0.6",
